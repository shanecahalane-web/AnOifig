# Disposable local-development values only. Copy to .env; never reuse in production.
# Production processes must explicitly receive ANOIFIG_ENVIRONMENT=production and
# private database URLs with sslmode=verify-full and an explicit sslrootcert path.
# Apply this to application AND owner URLs for migration/grant operations; mount
# the trusted CA in each process. See docs/adr/0003-production-database-tls.md.
# Alembic and grant_runtime.py read exported process variables, not .env files.
POSTGRES_PASSWORD=local-only-owner-password
ANOIFIG_APP_PASSWORD=local-only-app-password
ANOIFIG_ENVIRONMENT=development
ANOIFIG_DATABASE_URL=postgresql+psycopg://anoifig_app:local-only-app-password@127.0.0.1:5432/anoifig
ANOIFIG_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:local-only-owner-password@127.0.0.1:5432/anoifig

# Optional trusted build CA bundle for networks with an approved HTTPS proxy.
# Use only with compose.build-ca.yaml; never disable certificate verification.
# ANOIFIG_BUILD_CA_FILE=/path/to/approved-complete-ca-bundle.pem

# The managed identity provider is deliberately unconfigured. Protected endpoints
# fail closed until all three OIDC settings are supplied. Never use unsigned tokens.
# Issuer must emit the strict API access-token contract in ADR 0002: RS256,
# typ=at+jwt (or application/at+jwt), dedicated single API audience, and required
# exp/iat/sub/client_id/jti. Do not use an OIDC ID token or refresh token here.
# Selecting a provider and reviewing its deployment policies remain prerequisites.
# ANOIFIG_OIDC_ISSUER=https://identity.example.invalid/
# ANOIFIG_OIDC_AUDIENCE=anoifig-api
# ANOIFIG_OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json

# Messaging is disabled by default; no live credentials are needed locally or in tests.
# Compose uses the local worker simulator even when Twilio ingress is enabled.
# Only enable a real provider after approval for that account/environment.
ANOIFIG_TWILIO_ENABLED=false
# ANOIFIG_TWILIO_HTTP_TIMEOUT=10
# ANOIFIG_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# ANOIFIG_TWILIO_AUTH_TOKEN=replace-through-approved-secret-delivery
# ANOIFIG_TWILIO_WHATSAPP_NUMBER=whatsapp:+35310000000
# Exact externally visible URLs, including any static query. Production requires HTTPS.
# Forwarded headers never select the URL used for signature verification.
# Status callbacks append an immutable outbox UUID as attempt_id automatically.
# ANOIFIG_TWILIO_INBOUND_URL=https://messaging.example.invalid/webhooks/twilio/inbound
# ANOIFIG_TWILIO_STATUS_URL=https://messaging.example.invalid/webhooks/twilio/status

# Dedicated, disposable integration database. Never use a customer database.
ANOIFIG_TEST_DATABASE_URL=postgresql+psycopg://anoifig_app:local-only-app-password@127.0.0.1:5432/anoifig_test
ANOIFIG_TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:local-only-owner-password@127.0.0.1:5432/anoifig_test

# Tara defaults to the local fixed acknowledgement. No live API calls.
ANOIFIG_TARA_MODE=acknowledgement
ANOIFIG_TARA_MODEL=gpt-4.1-mini
ANOIFIG_TARA_MEMORY_DAYS=30
ANOIFIG_TARA_HISTORY_MESSAGES=8
ANOIFIG_TARA_MAX_INPUT_TOKENS=16000
ANOIFIG_TARA_MAX_OUTPUT_TOKENS=1200
ANOIFIG_TARA_TIMEOUT_SECONDS=15
# Overall cancellable operation deadline, including retries; 1-90 seconds.
ANOIFIG_TARA_DEADLINE_SECONDS=60
ANOIFIG_TARA_MAX_RETRIES=1
# JSON; per-business UUID overrides use ANOIFIG_TARA_BUSINESS_BUDGETS.
ANOIFIG_TARA_DAILY_BUDGET='{"requests":100,"tokens":1000000,"cost_usd":"5"}'
# Live mode also requires a securely injected ANOIFIG_OPENAI_API_KEY and reviewed
# positive ANOIFIG_TARA_INPUT_PRICE_USD / ANOIFIG_TARA_OUTPUT_PRICE_USD per 1M tokens.
# No live key is provided or forwarded by the local Compose setup.
